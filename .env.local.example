NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=https://localhost:3002

# PostHog product analytics (frontend SDK). Used by `<PostHogProvider>`
# in app/layout.tsx and proxied via `next.config.ts` rewrites.
# IMPORTANT: host TLD is `.com`, NOT `.co` — the latter doesn't resolve
# and produces `getaddrinfo ENOTFOUND` when the SDK tries to send events.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_yourtoken
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
